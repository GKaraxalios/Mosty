# ═══════════════════════════════════════════════════════════════════
# MostyAPI — Google Cloud Run environment template
# ═══════════════════════════════════════════════════════════════════
# Copy this to .env.gcloud, fill in values, and use with deploy script.
# These variables are set as Cloud Run env vars / secrets.
# ═══════════════════════════════════════════════════════════════════

# ── Environment ──────────────────────────────────────────────────
APP_ENV=production
APP_NAME=MostyAPI
APP_VERSION=2.0.0
DEBUG=false

# ── API Keys ─────────────────────────────────────────────────────
# IMPORTANT: Use Secret Manager for these in production.
MOSTY_RAG_API_KEY=CHANGE_ME
ADMIN_API_KEY=CHANGE_ME

# ── Magento ──────────────────────────────────────────────────────
MAGENTO_GRAPHQL_URL=https://mosty.com/graphql
MAGENTO_STORE_CODE=default
MAGENTO_PAGE_SIZE=50
MAGENTO_REQUEST_TIMEOUT=30.0
# MAGENTO_ACCESS_TOKEN=   # Set via Secret Manager

# ── Google Cloud / Vertex AI ────────────────────────────────────
GOOGLE_CLOUD_PROJECT=YOUR_PROJECT_ID
# Required for Vertex AI Vector Search (Matching Engine) resource names
GOOGLE_CLOUD_PROJECT_NUMBER=
GOOGLE_CLOUD_LOCATION=europe-west1
# On Cloud Run, Workload Identity provides credentials automatically.
# Leave GOOGLE_APPLICATION_CREDENTIALS empty.
GOOGLE_APPLICATION_CREDENTIALS=

VERTEX_EMBEDDING_MODEL=text-embedding-005
VERTEX_GENERATIVE_MODEL=gemini-2.5-flash
VERTEX_INDEX_ID=
VERTEX_INDEX_ENDPOINT_ID=
VERTEX_DEPLOYED_INDEX_ID=
VERTEX_RAG_TOP_K=5

# ── Cloud SQL (MySQL) ───────────────────────────────────────────
# For Cloud SQL with Unix socket (recommended on Cloud Run):
DATABASE_URL_PRODUCTION=mysql+pymysql://USER:PASSWORD@/DB_NAME?unix_socket=/cloudsql/PROJECT:REGION:INSTANCE&charset=utf8mb4

# Or via individual vars (used if DATABASE_URL_PRODUCTION is not set):
# DB_HOST_PRODUCTION=127.0.0.1
# DB_PORT_PRODUCTION=3306
# DB_NAME_PRODUCTION=mosty
# DB_USER_PRODUCTION=mosty
# DB_PASSWORD_PRODUCTION=

DB_CHARSET=utf8mb4
MEMORY_BACKEND=mysql

# ── State Persistence (GCS) ────────────────────────────────────
# Cloud Run has ephemeral filesystem. Use GCS for state files.
CHUNK_STORE_PATH=gs://YOUR_BUCKET/mostyapi/chunk_store.json
SYNC_STATE_PATH=gs://YOUR_BUCKET/mostyapi/sync_state.json
INDEX_LOCK_PATH=data/.index_sync.lock

# ── Scheduler ───────────────────────────────────────────────────
# DISABLE in-process scheduler on Cloud Run; use Cloud Scheduler instead.
ENABLE_SCHEDULER=false

# ── Cache ────────────────────────────────────────────────────────
CACHE_ENABLED=true
CACHE_BACKEND=memory
CACHE_DEFAULT_TTL=300
CACHE_PRODUCTS_TTL=600
CACHE_RAG_SEARCH_TTL=120
CACHE_RAG_ANSWER_TTL=60

# ── Search / Reranking ──────────────────────────────────────────
HYBRID_DENSE_WEIGHT=0.7
HYBRID_SPARSE_WEIGHT=0.3
RERANK_ENABLED=true
RERANK_TOP_N=20
FINAL_TOP_K=5

# ── Conversational Memory ───────────────────────────────────────
MEMORY_ENABLED=true
MEMORY_TTL_MINUTES=60
DEFAULT_ASSISTANT_LANGUAGE=auto

# ── Rate Limiting ───────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=120/minute
RATE_LIMIT_AI=30/minute
RATE_LIMIT_SYNC=5/minute

# ── CORS ─────────────────────────────────────────────────────────
CORS_ORIGINS=https://mosty.com,https://www.mosty.com
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*
CORS_ALLOW_CREDENTIALS=false
