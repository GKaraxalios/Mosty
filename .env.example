# ── MostyAPI v2 Configuration ────────────────────────────────────────────────
# Base file. For local dev create also .env.local (overrides; add to .gitignore).

# Environment: "local" or "production" (controls which defaults/overrides apply)
APP_ENV=local

# API authentication (leave empty for unrestricted dev access)
MOSTY_RAG_API_KEY=super_secret_key

# When true, /chat hides the API key field (pair with server-injected key or session auth).
CHAT_HIDE_API_KEY_UI=false

# Map preview in /chat (Google Maps embed + open link). Disable if you do not want embedded maps.
CHAT_ENABLE_MAP_PREVIEW=true
# Open “Google Maps” link in a new tab from the map card.
CHAT_MAPS_OPEN_IN_NEW_TAB=true

# Admin-only endpoints (AI evals, monitoring). Use a separate key; leave empty to disable admin routes.
ADMIN_API_KEY=

# ── Magento GraphQL ──────────────────────────────────────────────────────────
MAGENTO_GRAPHQL_URL=https://mosty.com/graphql
# Optional: public storefront origin for /media/... image URLs (empty = derived from MAGENTO_GRAPHQL_URL host).
# STORE_PUBLIC_ORIGIN=https://mosty.com
MAGENTO_STORE_CODE=default
MAGENTO_PAGE_SIZE=50
MAGENTO_REQUEST_TIMEOUT=30.0

# ── Google Cloud / Vertex AI ─────────────────────────────────────────────────
GOOGLE_CLOUD_PROJECT=your-project-id
# Numeric project id (IAM & Admin → Settings, or gcloud projects describe --format='value(projectNumber)')
GOOGLE_CLOUD_PROJECT_NUMBER=
GOOGLE_CLOUD_LOCATION=europe-west1
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# Vertex AI models
VERTEX_EMBEDDING_MODEL=text-embedding-005
VERTEX_GENERATIVE_MODEL=gemini-2.5-flash

# Vertex AI Vector Search (fill after running: python -m scripts.create_vertex_index)
VERTEX_INDEX_ID=
VERTEX_INDEX_ENDPOINT_ID=
VERTEX_DEPLOYED_INDEX_ID=
VERTEX_RAG_TOP_K=5

# ── Chunking ─────────────────────────────────────────────────────────────────
CHUNK_MAX_TOKENS=512
CHUNK_OVERLAP_TOKENS=64

# ── Scheduler ────────────────────────────────────────────────────────────────
ENABLE_SCHEDULER=false
FULL_SYNC_CRON="0 3 * * *"
INCREMENTAL_SYNC_INTERVAL_MINUTES=30
INCREMENTAL_SYNC_ENABLED=true

# ── Cache ────────────────────────────────────────────────────────────────────
CACHE_ENABLED=true
CACHE_BACKEND=memory
CACHE_DEFAULT_TTL=300
CACHE_PRODUCTS_TTL=600
CACHE_RAG_SEARCH_TTL=120
CACHE_RAG_ANSWER_TTL=60

# ── Hybrid Search ────────────────────────────────────────────────────────────
HYBRID_DENSE_WEIGHT=0.7
HYBRID_SPARSE_WEIGHT=0.3
# Deprecated: prefer HYBRID_RELAX_ON_EMPTY for chat retrieval.
HYBRID_RELAX_CATEGORY_ON_EMPTY=false
# When true (default), if product search returns no usable results, retry with relaxed filters (color → facets → category → size).
HYBRID_RELAX_ON_EMPTY=true

# ── Reranking ────────────────────────────────────────────────────────────────
RERANK_ENABLED=true
RERANK_TOP_N=20
FINAL_TOP_K=5

# ── Conversational Memory ───────────────────────────────────────────────────
MEMORY_ENABLED=true
MEMORY_TTL_MINUTES=60
DEFAULT_ASSISTANT_LANGUAGE=auto
# Backend: "memory" (default, in-RAM) or "mysql" for persistent storage
MEMORY_BACKEND=memory

# ── MySQL (when MEMORY_BACKEND=mysql) ───────────────────────────────────────
# Picked by APP_ENV: local → *_LOCAL, production → *_PRODUCTION
# Local (APP_ENV=local)
DB_HOST_LOCAL=localhost
DB_PORT_LOCAL=3306
DB_NAME_LOCAL=mosty
DB_USER_LOCAL=mosty
DB_PASSWORD_LOCAL=

# MAMP: use port 8889 and usually user root / password root:
# DB_PORT_LOCAL=8889
# DB_USER_LOCAL=root
# DB_PASSWORD_LOCAL=root

# Production (APP_ENV=production) — set real host/user/pass on server
# DB_HOST_PRODUCTION=your-db-host
# DB_PORT_PRODUCTION=3306
# DB_NAME_PRODUCTION=mosty
# DB_USER_PRODUCTION=mosty
# DB_PASSWORD_PRODUCTION=

DB_CHARSET=utf8mb4
# Optional: full URL per env (overrides split vars)
# DATABASE_URL_LOCAL=mysql+pymysql://user:pass@localhost:3306/mosty?charset=utf8mb4
# DATABASE_URL_PRODUCTION=mysql+pymysql://user:pass@prod-host:3306/mosty?charset=utf8mb4

# ── Weather (outfit recommendations, Open-Meteo, no API key) ───────────────────
# OPENMETEO_BASE_URL=https://api.open-meteo.com/v1
# OPENMETEO_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1
# OPENMETEO_TIMEOUT=10

# ── Rate Limiting ────────────────────────────────────────────────────────────
# Per-IP (or per-API-key if x-mosty-api-key header is sent)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=120/minute
RATE_LIMIT_AI=30/minute
RATE_LIMIT_SYNC=5/minute

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. Use * to allow all (dev only).
CORS_ORIGINS=*
# CORS_ORIGINS=https://mosty.com,https://www.mosty.com,http://localhost:3000
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*
CORS_ALLOW_CREDENTIALS=false

# ── App ──────────────────────────────────────────────────────────────────────
APP_NAME=MostyAPI
APP_VERSION=2.0.0
DEBUG=false
# Print full system + user LLM prompts to the server console (stdout) for /chat (stylist + info-only).
LOG_STYLIST_PROMPT=false

# ── File logging (app.core.logging) ───────────────────────────────────────────
# LOG_TO_FILE=true
# LOG_FILE_PATH=logs/app.log
# LOG_FILE_MAX_BYTES=10485760
# LOG_FILE_BACKUP_COUNT=5
# LOG_ERROR_TO_SEPARATE_FILE=true
# LOG_ERROR_FILE_PATH=logs/errors.log
# LOG_ERROR_FILE_MAX_BYTES=10485760
# LOG_ERROR_FILE_BACKUP_COUNT=5
# LOG_LEVEL=   # empty = INFO (or DEBUG if DEBUG=true). Or: DEBUG, WARNING, ERROR

# When true: disables all RAG metadata filters (debug only — hurts queries like «κόκκινα φορέματα»).
COMMERCE_SEARCH_FILTERS_DISABLED=false
# If strict metadata filters match zero chunks, search the full catalog anyway (query still ranks results).
HYBRID_FALLBACK_WHEN_NO_ELIGIBLE=true

# ── ES hybrid search (optional; default off → legacy Vertex + in-memory BM25) ──
ES_HYBRID_ENABLED=false
ELASTICSEARCH_URL=
ELASTICSEARCH_INDEX=mosty_chunks
ELASTICSEARCH_API_KEY=
# ELASTICSEARCH_USER= / ELASTICSEARCH_PASSWORD= as alternative to API key
ES_EMBEDDING_PROVIDER=google   # or "none" for keyword-only
